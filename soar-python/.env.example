# Zero Trust SOC - SOAR Engine Environment Configuration
# Copy this file to .env and fill in your values

# Ingestion Settings
WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json
OPENVAS_VULN_MAP_PATH=/opt/soar/openvas_snapshot.json
SOAR_POINTER_FILE=/opt/soar/alerts.pointer

# Threat Intelligence APIs (Optional for demo)
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_KEY
VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_KEY

# Telegram Administrative Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# OPNsense Gateway API
OPNSENSE_BASE_URL=https://10.0.10.1/api/firewall/alias_util/add/Blocked_IPs
OPNSENSE_API_KEY=YOUR_OPNSENSE_KEY
OPNSENSE_API_SECRET=YOUR_OPNSENSE_SECRET

# Global Settings
VERIFY_TLS=false
PROXMOX_HOST=192.168.1.7
LOG_LEVEL=INFO
