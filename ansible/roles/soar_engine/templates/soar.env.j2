OPNSENSE_BASE_URL=https://{{ soar_opnsense_host | default(hostvars['opnsense-gw']['ansible_host'] | default('192.168.1.125')) }}/api/firewall/alias_util/add/Blocked_IPs
OPNSENSE_API_KEY={{ hostvars['opnsense-gw']['ansible_opnsense_key'] }}
OPNSENSE_API_SECRET={{ hostvars['opnsense-gw']['ansible_opnsense_secret'] }}
VERIFY_TLS={{ soar_verify_tls | default(false) | string | lower }}
PROXMOX_HOST={{ proxmox_host | default('192.168.1.7') }}
WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json
SOAR_POINTER_FILE=/opt/soar/alerts.pointer
OPENVAS_VULN_MAP_PATH=/opt/soar/openvas_snapshot.json
TELEGRAM_BOT_TOKEN={{ lookup('ansible.builtin.env', 'TELEGRAM_BOT_TOKEN') }}
TELEGRAM_CHAT_ID={{ lookup('ansible.builtin.env', 'TELEGRAM_CHAT_ID') }}
